# =====================================================================
# .env — generated by scanning every os.getenv() / os.environ[] call
# in the repo. Fill in real values on the right of each "=".
#
# IMPORTANT: this file must NEVER be committed. Confirm .env is in
# .gitignore before you save real keys into this file.
# =====================================================================

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Redis (Upstash) ---
# REDIS_URL is used when set; REDIS_HOST/REDIS_PORT are the fallback if
# REDIS_URL isn't provided (see redis_cache.py). On Upstash, REDIS_URL is
# the one to use — it's the full rediss://... connection string from the
# Upstash console.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

# --- InfluxDB (self-hosted on Fly.io) ---
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=
FIREBASE_DATABASE_URL=

# --- Stripe: LIVE/production keys ---
# NOTE: env_keys_usage.csv previously had a live Stripe key committed to
# git in plaintext. Rotate that key in the Stripe dashboard before using
# it here — treat the old one as permanently compromised.
PRODUCTION_STRIPE_API_KEY=
PRODUCTION_STRIPE_PUBLISHABLE_KEY=
PRODUCTION_STRIPE_WEBHOOK_SECRET=
PRODUCTION_STARTER_WEEKLY_PRICE_ID=
PRODUCTION_STARTER_MONTHLY_PRICE_ID=
PRODUCTION_PRO_WEEKLY_PRICE_ID=
PRODUCTION_PRO_MONTHLY_PRICE_ID=
PRODUCTION_TEST_DRIVE_PRICE_ID=

# --- Stripe: TEST keys ---
TEST_STRIPE_API_KEY=
TEST_STRIPE_PUBLISHABLE_KEY=
TEST_STRIPE_WEBHOOK_SECRET_SNAPSHOT_PAYLOAD_STYLE=
TEST_STARTER_WEEKLY_PRICE_ID=
TEST_STARTER_MONTHLY_PRICE_ID=
TEST_PRO_WEEKLY_PRICE_ID=
TEST_PRO_MONTHLY_PRICE_ID=
TEST_TEST_DRIVE_PRICE_ID=

# --- Telegram bot (telegram_app_handler) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_PORT=8001
